# NeonOS dev container: linting, branding generation, podman, QEMU.
# Pinned to a Fedora release so it matches the fedora-bootc base used in M1.
FROM docker.io/library/fedora:44

RUN dnf -y install --setopt=install_weak_deps=False \
        bash git just ShellCheck file findutils which \
        python3 python3-pyyaml python3-fonttools \
        podman fuse-overlayfs \
        qemu-system-x86-core qemu-img edk2-ovmf \
    && dnf clean all

# The repo is bind-mounted from Windows, so it is owned by another uid.
RUN git config --system --add safe.directory /workspace

WORKDIR /workspace
CMD ["bash"]
